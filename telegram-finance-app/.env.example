# Токен від @BotFather (обов'язково)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Публічний HTTPS-домен Mini App. Можна лишити порожнім —
# тоді працює лише бот (кнопки + текст), без екрана з графіками.
WEBAPP_URL=

# Хто має доступ. Telegram ID через кому. Порожньо = доступ усім, хто знайде бота.
# Свій ID бот підкаже: напиши йому /start, коли список уже не порожній.
ALLOWED_USERS=
ADMIN_USERS=

# Валюта за замовчуванням для нових користувачів
DEFAULT_CURRENCY=UAH
TZ_NAME=Europe/Kyiv

# Де лежить база (один файл SQLite)
DB_PATH=./data/finance.db

# API-сервер Mini App
HOST=127.0.0.1
PORT=8080

# Тільки для розробки: відкрити Mini App у звичайному браузері без Telegram.
# У бойовому режимі має бути порожнім!
DEV_USER_ID=
