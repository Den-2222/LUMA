[Unit]
Description=Telegram finance bot
Documentation=https://github.com/Den-2222/LUMA
After=network-online.target
Wants=network-online.target
# Не даємо циклу перезапусків з'їсти сервер, якщо токен невалідний
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python -m bot
Restart=always
RestartSec=5

# Мінімальні права: сервісу потрібен лише каталог з базою
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DATA_DIR__
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=finance-bot

[Install]
WantedBy=multi-user.target
