{%- comment -%} Slide-out cart drawer. Rendered globally in theme.liquid. {%- endcomment -%}
{%- if settings.cart_type == 'drawer' -%}
<aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-label="Shopping cart" role="dialog">
  <div class="cart-drawer__head">
    <h3 class="h4" style="margin:0">Your bag</h3>
    <button type="button" data-cart-close aria-label="Close cart">{% render 'icon', name: 'close' %}</button>
  </div>

  <div class="cart-drawer__body">
    {%- if settings.cart_free_shipping_bar -%}
      <div class="free-ship" data-free-ship {% if settings.cart_free_shipping_threshold <= 0 %}hidden{% endif %}>
        <p class="free-ship__msg" data-free-ship-msg></p>
        <div class="free-ship__bar"><div class="free-ship__fill" data-free-ship-fill></div></div>
      </div>
    {%- endif -%}

    <div data-cart-items>
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty"><p>Your bag is empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="line-item" data-line="{{ forloop.index }}">
            <a href="{{ item.url }}">
              {%- if item.image -%}<img class="line-item__img" src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" loading="lazy">{%- endif -%}
            </a>
            <div class="line-item__info">
              <a href="{{ item.url }}" class="line-item__title">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}<span class="line-item__variant">{{ item.variant.title }}</span>{%- endunless -%}
              <div class="qty-stepper">
                <button type="button" data-qty="minus" aria-label="Decrease">&minus;</button>
                <input type="number" min="0" value="{{ item.quantity }}" data-line-qty="{{ forloop.index }}" aria-label="Quantity">
                <button type="button" data-qty="plus" aria-label="Increase">+</button>
              </div>
              <div class="line-item__bottom">
                <span class="price">
                  {%- if item.original_line_price > item.final_line_price -%}<s class="price__compare">{{ item.original_line_price | money }}</s>{%- endif -%}
                  {{ item.final_line_price | money }}
                </span>
                <button type="button" class="line-item__remove" data-line-remove="{{ forloop.index }}">Remove</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <div class="cart-drawer__foot" data-cart-foot {% if cart.item_count == 0 %}hidden{% endif %}>
    <div class="cart-drawer__totals">
      <span>Subtotal</span>
      <span data-cart-total>{{ cart.total_price | money }}</span>
    </div>
    <p class="text-muted" style="font-size:.82rem; margin-bottom:1rem;">Shipping & taxes calculated at checkout.</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn--full btn--large">Checkout</button>
    </form>
  </div>
</aside>
{%- endif -%}
