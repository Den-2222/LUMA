<section class="section {% if section.settings.bg_surface %}bg-surface{% endif %}">
  <div class="page-width">
    <div class="section-header text-center" data-reveal-group>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="faq accordion" data-accordion data-accordion-single data-reveal-group>
      {%- for block in section.blocks -%}
        <div class="accordion__item" data-reveal {{ block.shopify_attributes }}>
          <button class="accordion__trigger" aria-expanded="false">
            <span class="h4" style="margin:0">{{ block.settings.question }}</span>
            <span class="accordion__icon">{% render 'icon', name: 'plus', size: 22 %}</span>
          </button>
          <div class="accordion__panel">
            <div><div class="faq__answer rte">{{ block.settings.answer }}</div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "bg_surface", "label": "Surface background", "default": false }
  ],
  "blocks": [{
    "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How do I use this?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Apply morning and night to clean skin for best results.</p>" }
    ]
  }],
  "presets": [{ "name": "FAQ", "blocks": [
    {"type":"qa","settings":{"question":"How long until I see results?","answer":"<p>Most see a visible glow within 2 weeks, with full results at 4–8 weeks.</p>"}},
    {"type":"qa","settings":{"question":"Is it suitable for sensitive skin?","answer":"<p>Yes — our formulas are fragrance-free and dermatologist tested.</p>"}},
    {"type":"qa","settings":{"question":"What's your return policy?","answer":"<p>We offer a 30-day glow guarantee. Not in love? We'll refund you.</p>"}},
    {"type":"qa","settings":{"question":"Is it cruelty-free and vegan?","answer":"<p>Always. LUMA is 100% vegan and never tested on animals.</p>"}}
  ]}]
}
{% endschema %}
