{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
-%}
{%- if section.settings.enable and product != blank and variant -%}
<div class="promo-pop" data-promo-pop data-promo-scroll="{{ section.settings.scroll_trigger | default: 55 }}" hidden>
  <div class="promo-pop__backdrop" data-promo-close></div>
  <div class="promo-pop__card" role="dialog" aria-modal="true" aria-label="Special offer">
    <button class="promo-pop__x" data-promo-close aria-label="Close">{% render 'icon', name: 'close', size: 20 %}</button>

    <div class="promo-pop__media">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy">
      {%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
      {%- if product.compare_at_price > product.price -%}
        {%- assign save = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
        <span class="promo-pop__save">Save {{ save }}%</span>
      {%- endif -%}
    </div>

    <div class="promo-pop__body">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:var(--color-accent)">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h3 class="h3" style="margin:.2rem 0">{{ section.settings.heading }}</h3>{%- endif -%}
      <p class="promo-pop__name">{{ product.title }}</p>
      {%- if section.settings.text != blank -%}<p class="text-muted" style="font-size:.92rem">{{ section.settings.text }}</p>{%- endif -%}
      <div class="promo-pop__price">{% render 'price', product: product, show_save: false %}</div>

      {%- form 'product', product, data-quick-add-form: '' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button type="submit" class="btn btn--full btn--large">{{ section.settings.button_label | default: 'Add to bag' }}</button>
      {%- endform -%}
      <a href="{{ product.url }}" class="promo-pop__link" data-promo-close>View product details</a>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Promo popup",
  "settings": [
    { "type": "paragraph", "content": "A one-time popup that appears after the visitor scrolls down the page — nudging them toward your hero product. Shows the product's current price (set the discount on the product itself)." },
    { "type": "checkbox", "id": "enable", "label": "Enable popup", "default": false },
    { "type": "product", "id": "product", "label": "Featured product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Today only · bestseller" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't miss the glow everyone's loving" },
    { "type": "text", "id": "text", "label": "Text", "default": "Our #1 product, now at a special price. Grab it before it's gone." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to bag" },
    { "type": "range", "id": "scroll_trigger", "label": "Show after scrolling", "min": 25, "max": 90, "step": 5, "unit": "%", "default": 55 }
  ],
  "presets": [{ "name": "Promo popup" }]
}
{% endschema %}
