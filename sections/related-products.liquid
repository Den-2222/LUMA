{%- liquid
  assign products = recommendations.products
  if section.settings.collection != blank and products == empty
    assign products = collections[section.settings.collection].products
  endif
-%}
<section class="section">
  <div class="page-width">
    <div class="section-header text-center" data-reveal-group>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr));" data-reveal-group>
      {%- if products.size > 0 -%}
        {%- for product in products limit: section.settings.limit -%}
          {% render 'product-card', product: product, reveal: true %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          {%- assign pi = i | modulo: 6 | plus: 1 -%}
          <div class="card card--product" data-reveal>
            <div class="card__media media media--portrait">{{ 'product-' | append: pi | placeholder_svg_tag }}</div>
            <div class="card__body"><span class="card__title">Product title</span><span class="price">$00.00</span></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- if recommendations.performed == false and template.name == 'product' -%}
  <script>
    fetch('{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}')
      .then(r => r.text()).then(html => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const fresh = doc.querySelector('#shopify-section-{{ section.id }} .grid');
        const cur = document.querySelector('#shopify-section-{{ section.id }} .grid');
        if (fresh && cur) { cur.innerHTML = fresh.innerHTML; document.dispatchEvent(new Event('shopify:section:load')); }
      });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also love" },
    { "type": "collection", "id": "collection", "label": "Fallback collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
