<div class="announcement" data-announcement="{{ section.settings.rotate_speed }}"
     style="background:{{ section.settings.bg }};color:{{ section.settings.text }};">
  <div class="announcement__viewport">
    {%- for block in section.blocks -%}
      <div class="announcement__slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{% endif -%}
          {%- if block.settings.icon != blank %}{% render 'icon', name: block.settings.icon, size: 16 %}{% endif -%}
          <span>{{ block.settings.text }}</span>
        {%- if block.settings.link != blank -%}</a>{% endif -%}
      </div>
    {%- else -%}
      <div class="announcement__slide is-active"><span>Free shipping on orders over $50 — shop now</span></div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#2b2326" },
    { "type": "color", "id": "text", "label": "Text", "default": "#fdf6f4" },
    { "type": "range", "id": "rotate_speed", "label": "Rotation speed", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          {"value":"","label":"None"},{"value":"truck","label":"Truck"},{"value":"sparkle","label":"Sparkle"},
          {"value":"leaf","label":"Leaf"},{"value":"heart","label":"Heart"},{"value":"shield","label":"Shield"}
        ], "default": "truck" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [
    {"type":"message","settings":{"text":"Free shipping on orders over $50","icon":"truck"}},
    {"type":"message","settings":{"text":"30-day glow guarantee","icon":"shield"}},
    {"type":"message","settings":{"text":"Clean, cruelty-free skincare","icon":"leaf"}}
  ]}]
}
{% endschema %}
