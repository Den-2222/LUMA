<section class="section {% if section.settings.gradient %}bg-gradient{% endif %}">
  <div class="page-width">
    <div class="section-header text-center" data-reveal-group>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 data-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="text-muted" data-reveal>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="ugc__row" data-reveal-group>
      {%- for block in section.blocks -%}
        <div class="ugc__item" data-ugc-item data-ugc-autoplay data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: image_size: '600x', loop: true, muted: true, controls: false, playsinline: true, class: 'ugc__video' }}
          {%- elsif block.settings.video_url != blank -%}
            <video src="{{ block.settings.video_url }}" loop muted playsinline data-autoplay poster="{% if block.settings.poster %}{{ block.settings.poster | image_url: width: 600 }}{% endif %}"></video>
          {%- elsif block.settings.poster != blank -%}
            <img src="{{ block.settings.poster | image_url: width: 600 }}" alt="{{ block.settings.caption | escape }}">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if block.settings.video != blank or block.settings.video_url != blank -%}
            <button class="ugc__play" data-ugc-play aria-label="Play">{% render 'icon', name: 'play', size: 40 %}</button>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<span class="ugc__caption">{{ block.settings.caption }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC video",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "#LUMAglow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved & shared by you" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real routines from the LUMA community." },
    { "type": "checkbox", "id": "gradient", "label": "Gradient background", "default": false }
  ],
  "blocks": [{
    "type": "video", "name": "Video", "settings": [
      { "type": "video", "id": "video", "label": "Shopify-hosted video" },
      { "type": "text", "id": "video_url", "label": "External video URL (.mp4)" },
      { "type": "image_picker", "id": "poster", "label": "Poster image" },
      { "type": "text", "id": "caption", "label": "Caption", "default": "@glowgirl" }
    ]
  }],
  "presets": [{ "name": "UGC video", "blocks": [
    {"type":"video","settings":{"caption":"@glowgirl"}},
    {"type":"video","settings":{"caption":"@skindiary"}},
    {"type":"video","settings":{"caption":"@dewyroutine"}},
    {"type":"video","settings":{"caption":"@morningglow"}}
  ]}]
}
{% endschema %}
