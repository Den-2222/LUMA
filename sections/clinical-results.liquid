<section class="section {% if section.settings.gradient %}bg-gradient{% elsif section.settings.dark %}{% endif %}"
  style="{% if section.settings.dark %}background:{{ section.settings.dark_bg }};color:#fff;{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header text-center" data-reveal-group>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 data-reveal>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p data-reveal class="{% unless section.settings.dark %}text-muted{% endunless %}">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid stats__grid" data-reveal-group>
      {%- for block in section.blocks -%}
        <div class="stat" data-reveal {{ block.shopify_attributes }}>
          <span class="stat__num">
            {%- if block.settings.prefix != blank %}{{ block.settings.prefix }}{% endif -%}
            <span data-countup="{{ block.settings.number }}">0</span>{%- if block.settings.suffix != blank %}<span class="stat__suffix">{{ block.settings.suffix }}</span>{% endif -%}
          </span>
          <p class="stat__label {% if section.settings.dark %}{% else %}text-muted{% endif %}">{{ block.settings.label }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="text-center {% unless section.settings.dark %}text-muted{% endunless %}" data-reveal style="font-size:.78rem;margin-top:2rem;opacity:.7;">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Clinical results",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Clinically proven" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Results you can measure" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "In an independent consumer study over 8 weeks." },
    { "type": "text", "id": "note", "label": "Footnote", "default": "*Based on a 120-participant consumer perception study." },
    { "type": "checkbox", "id": "gradient", "label": "Gradient background", "default": true },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false },
    { "type": "color", "id": "dark_bg", "label": "Dark background color", "default": "#2b2326" }
  ],
  "blocks": [{
    "type": "stat", "name": "Statistic", "settings": [
      { "type": "text", "id": "prefix", "label": "Prefix", "default": "" },
      { "type": "text", "id": "number", "label": "Number", "info": "Numbers only, e.g. 94 or 4.8", "default": "94" },
      { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
      { "type": "text", "id": "label", "label": "Label", "default": "saw smoother, plumper skin" }
    ]
  }],
  "presets": [{ "name": "Clinical results", "blocks": [
    {"type":"stat","settings":{"number":"94","suffix":"%","label":"saw smoother, plumper skin"}},
    {"type":"stat","settings":{"number":"89","suffix":"%","label":"reported a visible glow"}},
    {"type":"stat","settings":{"number":"96","suffix":"%","label":"would recommend to a friend"}},
    {"type":"stat","settings":{"number":"72","suffix":"hr","label":"of continuous hydration"}}
  ]}]
}
{% endschema %}
