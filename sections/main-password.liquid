<section style="min-height:100vh;display:grid;place-items:center;padding:2rem;text-align:center;">
  <div class="page-width page-width--narrow">
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="max-height:60px;width:auto;margin:0 auto 2rem;">
    {%- else -%}
      <div class="footer__brand-name" style="color:var(--color-text);font-size:2rem;margin-bottom:1.5rem;">{{ section.settings.brand_name | default: shop.name }}</div>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    <p class="text-muted" style="font-size:1.1rem;">{{ section.settings.text }}</p>

    <div style="max-width:420px;margin:2rem auto 0;">
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="prelaunch">
        <div style="display:flex;gap:.5rem;">
          <input type="email" name="contact[email]" placeholder="Email address" class="input" required>
          <button type="submit" class="btn">{% render 'icon', name: 'arrow' %}</button>
        </div>
        {%- if form.posted_successfully? -%}<p style="margin-top:1rem;">Thanks — we'll be in touch ✨</p>{%- endif -%}
      {%- endform -%}
    </div>

    <div style="margin-top:2.5rem;">
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <details>
          <summary class="link-underline" style="cursor:pointer;">Enter using password</summary>
          <div style="display:flex;gap:.5rem;max-width:420px;margin:1rem auto 0;">
            <input type="password" name="password" placeholder="Password" class="input">
            <button type="submit" class="btn">Enter</button>
          </div>
        </details>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "LUMA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something beautiful is coming" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the glow list for early access and 10% off launch." }
  ]
}
{% endschema %}
