<section class="section bg-gradient" style="min-height:60vh;display:grid;place-items:center;text-align:center;">
  <div class="page-width page-width--narrow" data-reveal-group>
    <p class="eyebrow" data-reveal>404</p>
    <h1 data-reveal>{{ section.settings.heading }}</h1>
    <p class="text-muted" data-reveal>{{ section.settings.text }}</p>
    <div data-reveal style="margin-top:1.5rem;"><a href="{{ routes.root_url }}" class="btn">{{ section.settings.button_label }}</a></div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page took a glow break" },
    { "type": "text", "id": "text", "label": "Text", "default": "We couldn't find that page — but your routine awaits." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Back to home" }
  ]
}
{% endschema %}
