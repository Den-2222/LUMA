<section class="section">
  <div class="page-width">
    <div class="section-header text-center" data-reveal-group>
      <h1 data-reveal>{{ blog.title }}</h1>
    </div>
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr));" data-reveal-group>
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="card" data-reveal style="display:block;">
          <div class="media media-zoom media--landscape">
            {%- if article.image -%}<img class="lazy-img" src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy">
            {%- else -%}{{ 'blog-apparel-1' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <div class="card__body" style="padding:1.2rem;">
            <span class="eyebrow" style="margin-bottom:.4rem;">{{ article.published_at | date: '%b %d, %Y' }}</span>
            <span class="h4" style="margin:0">{{ article.title }}</span>
            <p class="text-muted" style="font-size:.92rem;">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Blog posts" }
{% endschema %}
