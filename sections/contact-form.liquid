<section class="section">
  <div class="page-width page-width--narrow">
    <div class="section-header text-center" data-reveal-group>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 data-reveal>{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="text-muted" data-reveal>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="contact" data-reveal-group>
      <div class="contact__details" data-reveal>
        {%- for block in section.blocks -%}
          <div class="contact__detail" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}{% render 'icon', name: block.settings.icon, size: 22 %}{%- endif -%}
            <div>
              <div class="contact__detail-label">{{ block.settings.label }}</div>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="contact__detail-value">{{ block.settings.value }}</a>
              {%- else -%}
                <div class="contact__detail-value">{{ block.settings.value }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="contact__form-wrap" data-reveal>
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="contact__success">{% render 'icon', name: 'check', size: 18 %} {{ section.settings.success_text }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="contact__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="contact__row">
            <label>
              <span>Name</span>
              <input type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}" required>
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" required>
            </label>
          </div>
          <label>
            <span>Subject</span>
            <input type="text" name="contact[subject]" value="{% if form.subject %}{{ form.subject }}{% endif %}">
          </label>
          <label>
            <span>Message</span>
            <textarea name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </label>
          <button type="submit" class="btn btn--large">{{ section.settings.button_label | default: 'Send message' }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're here to help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about your routine, an order, or a return? Our glow team replies within 24 hours." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks! We've received your message and will reply within 24 hours." }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact detail",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "heart", "label": "Heart" },
          { "value": "truck", "label": "Truck" },
          { "value": "shield", "label": "Shield" },
          { "value": "sparkle", "label": "Sparkle" },
          { "value": "", "label": "None" }
        ], "default": "heart" },
        { "type": "text", "id": "label", "label": "Label", "default": "Email us" },
        { "type": "text", "id": "value", "label": "Value", "default": "hello@luma.com" },
        { "type": "text", "id": "link", "label": "Link (optional)", "info": "e.g. mailto:hello@luma.com" }
      ]
    }
  ],
  "presets": [{ "name": "Contact form", "blocks": [
    { "type": "detail", "settings": { "icon": "heart", "label": "Email us", "value": "hello@luma.com", "link": "mailto:hello@luma.com" } },
    { "type": "detail", "settings": { "icon": "truck", "label": "Order help", "value": "Mon–Fri, 9am–6pm" } },
    { "type": "detail", "settings": { "icon": "sparkle", "label": "Follow us", "value": "@luma" } }
  ]}]
}
{% endschema %}
