<section class="section"><div class="page-width">
  <h1>Order {{ order.name }}</h1>
  <p class="text-muted">Placed {{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
  <table style="width:100%;border-collapse:collapse;margin-top:1.5rem;">
    <thead><tr style="text-align:left;border-bottom:1px solid var(--color-border);"><th style="padding:.8rem 0;">Item</th><th>Qty</th><th>Total</th></tr></thead>
    <tbody>
      {%- for line in order.line_items -%}
        <tr style="border-bottom:1px solid var(--color-border);">
          <td style="padding:.8rem 0;">{{ line.title }}</td><td>{{ line.quantity }}</td><td>{{ line.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
  <div class="cart-drawer__totals" style="margin-top:1.5rem;"><span>Total</span><span>{{ order.total_price | money }}</span></div>
  <p style="margin-top:1.5rem;"><a href="{{ routes.account_url }}" class="link-arrow">{% render 'icon', name: 'arrow', size: 16 %} Back to account</a></p>
</div></section>
