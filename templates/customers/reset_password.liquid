<section class="section"><div class="page-width page-width--narrow">
  <h1 class="text-center">Reset password</h1>
  <div style="max-width:420px;margin:0 auto;">
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" class="input" placeholder="New password" required style="margin-bottom:1rem;">
      <input type="password" name="customer[password_confirmation]" class="input" placeholder="Confirm password" required style="margin-bottom:1rem;">
      <button type="submit" class="btn btn--full btn--large">Reset password</button>
    {%- endform -%}
  </div>
</div></section>
